{
  // Multiplayer Everything Launcher configuration. Every game, player,
  // color and text lives here; see CONFIG.md for every option.
  // Paths are tried in order and the first one that exists wins. A path that
  // uses ${FLASHPOINT} is skipped on PCs without Flashpoint.
  "schemaVersion": 1,

  "branding": {
    "title": "Multiplayer Everything",
    "subtitle": "Mods and Flash games",
    "theme": "dark"
  },

  "paths": {
    "games": "${folder:Documents}\\MultiplayerEverythingLauncher\\games",
    "players": "${folder:Documents}\\MultiplayerEverythingLauncher\\players",
    "flashpoint": ["C:\\Flashpoint", "D:\\Flashpoint", "E:\\Flashpoint", "${folder:Profile}\\Flashpoint", "${folder:Desktop}\\Flashpoint"]
  },

  // Missing game files can be downloaded from the Multiplayer Everything games
  // repository; every file is checked against the SHA-256 in its catalog.
  // Open rooms come from the Multiplayer Everything central server. Its address is
  // read from mods-info, the same file the mods use; "server" is the fallback.
  "rooms": {
    "servers": "https://raw.githubusercontent.com/multiplayereverything/mods-info/main/servers.json",
    "server": "165.232.82.11:25569"
  },

  // "How did it run?" reports: asked after a long session, shown on each game's page.
  // The service is reports-api/ in this repository (a Cloudflare Worker).
  "reports": {
    "url": "https://multiplayer-everything-reports.multiplayereverythingofficial.workers.dev"
  },

  // The launcher updates itself from the newest release of its repository
  // (the file is checked against the SHA-256 GitHub publishes for it).
  // "app" and "appExe": the app that replaces the C++ window. A C++ launcher started on its own installs it
  // from the same release (its installer, "app"), then only opens it ("appExe", where the installer puts it).
  // The app updates itself (src-tauri/tauri.conf.json, plugins.updater).
  "updates": {
    "github": "multiplayereverything/multiplayer-mods-launcher", "asset": "MultiplayerEverythingLauncher.exe",
    "app": "MultiplayerEverything-setup.exe", "appExe": "${folder:LocalAppData}\\Multiplayer Everything\\MultiplayerEverything.exe"
  },

  // Discord shows "Playing <game>" while a game runs. Put the application id
  // from discord.com/developers here; empty turns it off.
  "discord": { "clientId": "" },

  "downloads": {
    "catalog": "https://raw.githubusercontent.com/multiplayereverything/flash-games/main/catalog.json",
    // mods-info as one download: every mod's record and the newest release of ours, from one commit.
    "modsInfoZip": "https://github.com/multiplayereverything/mods-info/archive/refs/heads/main.zip"
  },

  "behavior": {
    // Flash slows down windows that are minimized, so the launcher stays put by default.
    "minimizeOnLaunch": false,
    "stopRelayWithGame": true
  },

  "players": [
    {
      "id": "ruffle",
      // The only Flash player: Ruffle Together, our Ruffle build with online co-op. Everyone in a
      // room has to run the same build, so no other Ruffle or Flash Player is looked for. The id
      // stays "ruffle" so every game's "players" list and saved settings keep working.
      "name": "Ruffle Together",
      "website": "https://github.com/multiplayereverything/ruffle-together/releases",
      // Passes values into a game as FlashVars (used to hand a room code to the mods).
      "flashvarArg": "-P${KEY}=${VALUE}",
      // Which save a hosted co-op game starts from ("--coop-save solo|new"; the default needs no option).
      // Releases before "coopSaveSince" don't know it, so it is left out of their command line.
      "coopSaveArg": "--coop-save",
      "coopSaveSince": "1.0.3.6",
      // Started from TV mode: full screen on every release; from 1.0.6 the variable also turns on the controller,
      // the hold-Start menu and sofa-sized overlays. Older releases ignore the variable (an option they don't know
      // would stop them starting).
      "tv": {
        "args": ["--fullscreen"],
        "env": { "RUFFLE_TOGETHER_TV": "1" }
      },
      // When it isn't found, the launcher offers to install the newest release (checked against its SHA-256).
      "install": {
        "github": "multiplayereverything/ruffle-together",
        "asset": "RuffleTogether-*-windows-x64.zip",
        "dir": "${PLAYERS_DIR}\\ruffle-together",
        "exe": "ruffle_desktop.exe"
      },
      "paths": [
        "${PLAYERS_DIR}\\ruffle-together\\ruffle_desktop.exe",
        "${PLAYERS_DIR}\\ruffle_desktop.exe"
      ]
    }
  ],

  "categories": [
    // "icon": a Segoe Fluent Icons glyph for the sidebar.
    // "group": categories with the same group sit together; a line separates groups.
    { "id": "pc", "name": "PC mods", "icon": "E7F4", "group": "platform" },
    { "id": "flash", "name": "Flash mods", "icon": "E8B8", "group": "platform" },
    { "id": "online", "name": "Online multiplayer", "icon": "E774", "group": "kind" },
    { "id": "local", "name": "Local multiplayer", "icon": "E765", "group": "kind" },
    { "id": "coop", "name": "Co-op", "icon": "E716", "group": "kind" },
    { "id": "versus", "name": "Versus", "icon": "E945", "group": "kind" }
  ],

  "games": [
    {
      "id": "spore-coop",
      "name": "Spore",
      "players": "2-4 players (co-op)",
      "categories": ["pc"],
      "author": "WoodyWizard",
      "authorUrl": "https://github.com/WoodyWizard",
      "guide": {
        "needs": [
          "Your own copy of Spore with Galactic Adventures, from GOG or Steam (the current builds). Other copies start without co-op.",
          "Everyone you play with needs the same version of the mod."
        ],
        "steps": [
          "Open SporeCoop on GitHub and download its newest release. The launcher doesn't install this mod for now.",
          "Install it as its own instructions say, into the game's SporebinEP1 folder, then start Spore.",
          "In the main menu pick Co-op. Host a game, or join a friend on your network or by their address.",
          "Playing over the internet: use a virtual LAN such as Tailscale, ZeroTier or Radmin VPN (easiest), or forward UDP port 47810 to the host."
        ],
        "keys": [
          {
            "key": "F9",
            "does": "Opens the co-op window: players, stage, ping, chat and Leave."
          }
        ],
        "tips": [
          "Made by WoodyWizard, not by Multiplayer Everything. Report problems to its author.",
          "Windows Defender currently flags the mod's download, whose loader takes the place of the game's steam_api.dll. We can't confirm that is a false alarm, so the launcher only links to it.",
          "Type /bug and what you see in the co-op chat when something goes wrong, then send the logs of every player."
        ],
        "links": [
          {
            "label": "SporeCoop by WoodyWizard on GitHub",
            "url": "https://github.com/WoodyWizard/SporeCoop"
          }
        ]
      },
      "actions": [
        {
          "id": "page",
          "label": "Get SporeCoop on GitHub",
          "icon": "E774",
          "description": "By WoodyWizard: download and install it yourself",
          "link": "https://github.com/WoodyWizard/SporeCoop/releases"
        }
      ],
      "color": "#3E9C7A",
      "colorEnd": "#0C2A22",
      "description": "Co-op for Spore with Galactic Adventures (GOG and Steam) by WoodyWizard: two to four friends evolve in one world through every stage, from the cell to space. Made by WoodyWizard, not by us. Everyone needs the same version."
    }
  ]
}
