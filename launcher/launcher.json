      // A PC game mod: the launcher finds the game, installs the mod into it (every
      // file it replaces is backed up and put back on uninstall) and starts the game.
      // "package" says where the mod comes from; "components" map files of that package
      // into the game folder. The release zip below is the game-folder layout itself.
      "id": "spooky-together",
      "name": "Spooky Together",
      "site": "spooky",
      "players": "2-4 players (co-op)",
      "online": { "id": "spooky" },
      "categories": ["pc", "online", "coop"],
      "guide": {
