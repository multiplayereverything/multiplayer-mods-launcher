{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Multiplayer Everything",
  "version": "1.0.45",
  "identifier": "com.multiplayereverything.launcher",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Multiplayer Everything",
        "width": 1280,
        "height": 800,
        "decorations": false,
        "resizable": true,
        "fullscreen": false,
        "minWidth": 900,
        "minHeight": 560,
        "center": true,
        "backgroundColor": "#15171c",
        "devtools": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": { "enable": true, "scope": [] }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDA0RTQ5RjZBNTIwMkY3RjQKUldUMDl3SlNhcC9rQkh1Tzl2dVZnR0ZQOUt0dW8rWERWUllJWFl0bVQ3SXptQlV6bUlaUnBTbGcK",
      "endpoints": ["https://github.com/multiplayereverything/multiplayer-mods-launcher/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}